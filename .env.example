# npm run setup がトークンと鍵を生成します。電話番号・APIキーは各自で設定します。
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=.local/vonage-private.key
# サインアップ時に認証した本人の携帯番号。先頭の + は省略可能です。
PHONE_NUMBER=
# 無料試用のテスト発信元。ダッシュボードの指定値が異なる場合はその値を使います。
VONAGE_FROM=123456789

# cloudflared が表示する https://...trycloudflare.com のURL
PUBLIC_URL=
BRIDGE_TOKEN=
PORT=8787
# 空欄なら echo=30秒、live=180秒。指定できる範囲は1〜300秒です。
MAX_SECONDS=

# echo と tts では不要です。
OPENAI_API_KEY=
BACKEND_MODEL=gpt-5.6-luna
